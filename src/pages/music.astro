---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import { getProductsByCategory } from "../lib/woocommerce";

const musicProducts = await getProductsByCategory("music");
const whiteLabels = musicProducts.filter((product) => product.catalog.startsWith("FLIPSW"));
const regularReleases = musicProducts.filter((product) => !product.catalog.startsWith("FLIPSW"));
---

<BaseLayout title="Music - FLIPSIGHT">
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">01 - Music</div>
        <h1 class="fs-display mt-4 text-[clamp(48px,6.5vw,104px)]">A record archive.</h1>
      </div>
      <div class="grid gap-6">
        <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
          Releases pressed in small editions. Long-form listening, studio recordings, and occasional live documents. Each record is treated as an object: sleeve, weight, credits, silence between tracks.
        </p>
        <div class="flex justify-between border-t fs-soft-rule pt-3">
          <span class="fs-meta">{regularReleases.length} releases</span>
          <span class="fs-meta-muted">Newest first</span>
        </div>
      </div>
    </section>
    <ProductGrid products={regularReleases} category="music" />
    {whiteLabels.length > 0 && (
      <section class="grid gap-8">
        <div class="grid gap-4 border-t fs-rule pt-6 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <div class="fs-meta-muted">White label series</div>
            <h2 class="fs-display mt-2 text-[clamp(30px,3.4vw,48px)]">Hand-stamped cuts.</h2>
          </div>
          <p class="max-w-md text-[13px] leading-relaxed text-[var(--fs-ink-2)]">
            Small-run FLIPSW records, placed slightly aside from the main catalogue: direct, functional, and pressed for rooms that move.
          </p>
        </div>
        <ProductGrid products={whiteLabels} category="music" />
      </section>
    )}
  </div>
</BaseLayout>
