---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { events } from "../../data/events";
---

<BaseLayout title="Events - FLIPSIGHT">
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">04 - Events</div>
        <h1 class="fs-display mt-4 text-[clamp(48px,6.5vw,104px)]">Moments<br />in context.</h1>
      </div>
      <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
        Listening sessions, exhibitions, performances. Events live alongside releases and works, where the objects come to ground.
      </p>
    </section>

    <section>
      <SectionTitle eyebrow="Upcoming" note={`${events.length} dates`} />
      <div class="grid">
        {events.map((event) => <EventCard {...event} />)}
      </div>
    </section>
  </div>
</BaseLayout>
