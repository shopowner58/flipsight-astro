---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import { events as mockEvents } from "../../data/events";
import { getEvents } from "../../lib/wordpress";

const events = await getEvents();
const displayEvents = events.length > 0 ? events : mockEvents;
---

<BaseLayout title="Events - FLIPSIGHT">
  <div class="fs-page fs-page-stack">
    <section class="grid gap-8 border-b fs-rule pb-10 md:grid-cols-[2fr_3fr]">
      <div>
        <div class="fs-meta">04 - Events</div>
        <h1 class="fs-display mt-4 text-[clamp(54px,8vw,128px)]">Dates,<br />rooms,<br />signals.</h1>
      </div>
      <p class="max-w-xl self-end text-[18px] leading-relaxed text-[var(--fs-ink-2)]">
        Listening sessions, release parties, window sessions and rooms around the catalogue. This page is fed by the FLIPSIGHT event archive in WordPress.
      </p>
    </section>

    <section class="grid">
      {displayEvents.map((event) => <EventCard {...event} />)}
    </section>
  </div>
</BaseLayout>
