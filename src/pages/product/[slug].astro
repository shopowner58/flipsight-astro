---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import type { Product } from "../../data/products";
import { getAddToCartUrl, getCheckoutAddToCartUrl, getProductBySlug, getProducts, getVariationCheckoutUrl, SITE_URL } from "../../lib/woocommerce";

export const prerender = true;

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const product = Astro.props.product ?? (await getProductBySlug(Astro.params.slug ?? ""));

if (!product) {
  return Astro.redirect("/shop");
}

const products = await getProducts();
const related = products.filter((item) => item.category === product.category && item.slug !== product.slug).slice(0, 3);
const tone = `oklch(0.84 ${product.chroma} ${product.hue})`;
const buyHref =
  product.type === "variable"
    ? ""
    : product.category === "art"
    ? getCheckoutAddToCartUrl(product.id)
    : getAddToCartUrl(product.id, `/${product.category}`);
const canonicalUrl = `${SITE_URL}/product/${product.slug}`;
const variants = product.variants ?? [];
const galleryImages = [product.image, ...(product.gallery ?? [])].filter(Boolean).slice(0, 9);
const productMedium = product.category === "art" ? product.format?.split("·")[0]?.trim() : product.format;
const simpleArtFormat = product.format?.split("·").pop()?.trim() ?? product.format ?? "Artwork";
const bandcampEmbedSrc = product.bandcampAlbumId
  ? `https://bandcamp.com/EmbeddedPlayer/album=${product.bandcampAlbumId}/size=large/bgcol=ffffff/linkcol=333333/artwork=none/transparent=true/`
  : "";
const checkoutNote =
  product.category === "art"
    ? "Secure checkout, live stock control and edition handling are processed through the FLIPSIGHT shop. Every work is confirmed before packing, shipping or pickup."
    : "Secure checkout, live stock control and shipping are processed through the FLIPSIGHT shop. Orders ship from Antwerp when stock is available.";
---

<BaseLayout title={`${product.title} - FLIPSIGHT`} canonicalUrl={canonicalUrl}>
  <div class="fs-page fs-page-stack">
    <nav class="-mb-8 flex gap-3 font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--fs-mute)]">
      <a class="text-[var(--fs-ink)] hover:text-[var(--fs-accent)]" href={`/${product.category}`}>Back to {product.category}</a>
      <span>/</span>
      <span>{product.catalog}</span>
    </nav>

    <section class="grid items-start gap-[clamp(40px,5vw,96px)] lg:grid-cols-[1.2fr_1fr]">
      <div class="lg:sticky lg:top-28">
        <div class={`fs-vinyl-art ${product.aspect === "portrait" ? "aspect-[4/5]" : "aspect-square"}`} style={`--tone: ${tone}`}>
          {product.image && <img class="h-full w-full object-cover" src={product.image} alt={product.title} />}
        </div>
        {galleryImages.length > 1 && (
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {galleryImages.slice(1).map((image, index) => (
              <figure class="group border fs-soft-rule bg-[var(--fs-bg)] p-2">
                <img class="aspect-square w-full object-cover transition duration-300 group-hover:opacity-80" src={image} alt={`${product.title} detail ${index + 1}`} loading="lazy" />
              </figure>
            ))}
          </div>
        )}
        <div class="mt-4 flex justify-between border-t fs-soft-rule pt-3">
          <span class="fs-meta">{product.category} object</span>
          <span class="fs-meta-muted">Documentation on request</span>
        </div>
      </div>

      <div class="grid gap-5 pt-4">
        <div class="font-mono text-xs tracking-[0.12em] text-[var(--fs-mute)]">{product.catalog}</div>
        {product.artist && <div class="text-base font-medium uppercase tracking-[0.04em] text-[var(--fs-mute)]">{product.artist}</div>}
        <h1 class="fs-display text-[clamp(48px,6vw,96px)]">{product.category === "art" ? <em>{product.title}</em> : product.title}</h1>
        <p class="max-w-xl text-[17px] leading-relaxed text-[var(--fs-ink)]">{product.description}</p>

        <dl class="mt-2 grid gap-0 border-y fs-rule">
          <div class="grid grid-cols-[140px_1fr] gap-5 border-b fs-soft-rule py-4">
            <dt class="fs-meta-muted">{product.category === "art" ? "Medium" : "Format"}</dt>
            <dd>{productMedium}</dd>
          </div>
          <div class="grid grid-cols-[140px_1fr] gap-5 border-b fs-soft-rule py-4">
            <dt class="fs-meta-muted">Edition</dt>
            <dd>{product.editionInfo}</dd>
          </div>
          <div class="grid grid-cols-[140px_1fr] gap-5 border-b fs-soft-rule py-4">
            <dt class="fs-meta-muted">Year</dt>
            <dd>{product.year}</dd>
          </div>
          <div class="grid grid-cols-[140px_1fr] gap-5 py-4">
            <dt class="fs-meta-muted">Status</dt>
            <dd>{product.stockStatus}</dd>
          </div>
        </dl>

      {variants.length > 0 ? (
        <div class="mt-3 border-y fs-rule py-5">
          <div class="flex items-end justify-between gap-4">
            <div class="fs-meta-muted">Choose format</div>
            <div class="fs-meta">{variants.length} sizes</div>
          </div>
          <div class="mt-4 grid gap-3">
              {variants.map((variant) => (
                <a
                  class="grid gap-3 border fs-soft-rule px-4 py-4 transition-colors hover:border-[var(--fs-ink)] hover:bg-[var(--fs-bg-2)] sm:grid-cols-[1fr_auto_auto] sm:items-center"
                  href={getVariationCheckoutUrl(product.id, variant)}
                >
                  <span class="grid gap-1">
                    <span class="font-medium uppercase tracking-[0.03em]">{variant.label}</span>
                    {variant.editionLabel && (
                      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--fs-mute)]">{variant.editionLabel} next available</span>
                    )}
                  </span>
                  {variant.displayPrice && <span class="font-mono text-[12px] tracking-[0.08em]">{variant.displayPrice}</span>}
                  <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--fs-accent)]">
                    {variant.availabilityLabel === "Sold out" ? "Sold out" : "Buy this edition"}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <div class="mt-3 border-y fs-rule py-5">
            {product.category === "art" ? (
              <div class="grid gap-3">
                <a
                  class="grid gap-3 border fs-soft-rule px-4 py-4 transition-colors hover:border-[var(--fs-ink)] hover:bg-[var(--fs-bg-2)] sm:grid-cols-[1fr_auto_auto] sm:items-center"
                  href={buyHref}
                >
                  <span class="grid gap-1">
                    <span class="font-medium uppercase tracking-[0.03em]">{simpleArtFormat}</span>
                    {product.editionLabel && (
                      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--fs-mute)]">{product.editionLabel} next available</span>
                    )}
                  </span>
                  <span class="font-mono text-[12px] tracking-[0.08em]">{product.price}</span>
                  <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--fs-accent)]">
                    {product.stockStatus === "Sold out" || product.availabilityLabel === "Sold out" ? "Sold out" : "Buy this edition"}
                  </span>
                </a>
              </div>
            ) : (
              <div class="grid items-center gap-4 sm:grid-cols-[auto_1fr_auto]">
                <div class="fs-display text-[30px]">{product.price}</div>
                <Button href={buyHref} variant="primary" disabled={product.stockStatus === "Sold out"}>
                  {product.stockStatus === "Sold out" ? "Sold out" : "Add to cart"}
                </Button>
                {product.category === "music" && product.bandcampUrl && (
                  <Button href={product.bandcampUrl} variant="ghost" target="_blank" rel="noreferrer">Bandcamp</Button>
                )}
              </div>
            )}
          </div>
        )}

        <div class="border-t fs-soft-rule pt-5">
          <div class="fs-meta">{product.category === "art" ? "FLIPSART" : "Checkout"}</div>
          <p class="mt-3 max-w-lg text-[13px] leading-relaxed text-[var(--fs-ink-2)]">
            {checkoutNote}
          </p>
        </div>

        {bandcampEmbedSrc && (
          <section class="mt-8 border-t fs-rule pt-6">
            <div class="mb-4 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
              <div>
                <div class="fs-meta-muted">Preview / digital</div>
                <h2 class="fs-display mt-2 text-[30px]">Bandcamp player</h2>
              </div>
              {product.bandcampUrl && (
                <a class="fs-meta text-[var(--fs-accent)] hover:text-[var(--fs-ink)]" href={product.bandcampUrl} target="_blank" rel="noreferrer">
                  Open Bandcamp
                </a>
              )}
            </div>
            <div class="overflow-hidden border fs-soft-rule bg-white">
              <iframe
                class="block w-full"
                style="border: 0; height: 472px;"
                src={bandcampEmbedSrc}
                seamless
                title={`${product.title} Bandcamp player`}
              ></iframe>
            </div>
            <p class="mt-3 max-w-xl text-[12px] leading-relaxed text-[var(--fs-mute)]">
              Listen and buy digital through Bandcamp. Vinyl checkout on this site keeps the physical sale inside FLIPSIGHT.
            </p>
          </section>
        )}
      </div>
    </section>

    {related.length > 0 && (
      <section>
        <div class="mb-8 border-b fs-rule pb-4">
          <div class="fs-meta">Also in {product.category}</div>
        </div>
        <ProductGrid products={related} />
      </section>
    )}
  </div>
</BaseLayout>
