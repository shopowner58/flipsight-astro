---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import ProductGrid from "../components/ProductGrid.astro";
import { getProductsByCategory } from "../lib/woocommerce";

const merchProducts = await getProductsByCategory("merch");
---

<BaseLayout title="Merch - FLIPSIGHT">
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">03 - Merch</div>
        <h1 class="fs-display mt-4 text-[clamp(48px,6.5vw,104px)]">Worn in the studio.</h1>
      </div>
      <div class="grid gap-6">
        <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
          Apparel and small objects made in small runs, printed and cut alongside our releases. Heavy cottons, considered labels, no seasonality.
        </p>
        <p class="max-w-md border-t fs-soft-rule pt-4 text-[13px] leading-relaxed text-[var(--fs-mute)]">
          The embroidered logo tee is currently sold out. New merch is being sampled, washed, worn and checked before the next small run lands.
        </p>
        <div class="flex justify-between border-t fs-soft-rule pt-3">
          <span class="fs-meta">{merchProducts.length} pieces</span>
          <span class="fs-meta-muted">New run in progress</span>
        </div>
      </div>
    </section>
    <section class="grid items-start gap-[clamp(32px,5vw,80px)] lg:grid-cols-[minmax(0,1.2fr)_minmax(340px,0.8fr)]">
      <ProductGrid products={merchProducts} category="merch" />

      <aside class="border-y fs-rule bg-[var(--fs-bg-2)] px-5 py-6 sm:px-7 sm:py-8 lg:sticky lg:top-28">
        <div class="flex items-start justify-between gap-5 border-b fs-soft-rule pb-4">
          <div>
            <div class="fs-meta-muted">Next merch signal</div>
            <h2 class="fs-display mt-3 text-[clamp(28px,3vw,44px)] leading-[0.98]">
              Keep a rail open.
            </h2>
          </div>
          <div class="hidden border border-[var(--fs-line)] px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--fs-mute)] sm:block">
            Small run
          </div>
        </div>

        <p class="mt-5 text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
          The last tee moved out quietly. If the next FLIPSIGHT piece should pass by your inbox before it hits the room, leave a signal here.
        </p>
        <p class="mt-4 text-[13px] leading-relaxed text-[var(--fs-mute)]">
          Low-frequency only: prototypes, release windows and first notice when a new run is ready to wear.
        </p>

        <div class="mt-7 border-t fs-soft-rule pt-5">
          <NewsletterForm
            source="merch"
            idSuffix="merch"
            placeholder="your@email.com"
            buttonLabel="Keep me posted"
            consentLabel="Tell me when the next FLIPSIGHT merch run is ready."
            fullWidth
          />
        </div>
      </aside>
    </section>
  </div>
</BaseLayout>
