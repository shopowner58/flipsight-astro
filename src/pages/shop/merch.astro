---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { getProductsByCategory, SITE_URL } from "../../lib/woocommerce";

const products = await getProductsByCategory("merch");
---

<BaseLayout title="Shop Merch - FLIPSIGHT" canonicalUrl={`${SITE_URL}/shop/merch`}>
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">Shop / Merch</div>
        <h1 class="fs-display mt-4 text-[clamp(48px,6.5vw,104px)]">Studio pieces.</h1>
      </div>
      <div class="grid gap-5">
        <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
          Apparel and small objects add to the WooCommerce cart, with checkout handled by the existing FLIPSIGHT shop engine.
        </p>
        <p class="max-w-md border-t fs-soft-rule pt-4 text-[13px] leading-relaxed text-[var(--fs-mute)]">
          The embroidered logo tee is sold out for now. New merch is in development and will return as a small, controlled drop.
        </p>
      </div>
    </section>
    <ProductGrid products={products} category="merch" />
  </div>
</BaseLayout>
