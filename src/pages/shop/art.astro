---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { getProductsByCategory, SITE_URL } from "../../lib/woocommerce";

const products = await getProductsByCategory("art");
---

<BaseLayout title="Shop Art - FLIPSIGHT" canonicalUrl={`${SITE_URL}/shop/art`}>
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">Shop / Art</div>
        <h1 class="fs-display mt-4 text-[clamp(48px,6.5vw,104px)]">FLIPSART editions.</h1>
      </div>
      <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
        Unique works and limited editions route directly toward WooCommerce checkout to reduce cart limbo.
      </p>
    </section>
    <ProductGrid products={products} category="art" />
  </div>
</BaseLayout>
