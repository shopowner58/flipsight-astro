---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import { sortArtOldestFirst } from "../lib/art-display";
import { getProductsByCategory } from "../lib/woocommerce";

const artProducts = sortArtOldestFirst(await getProductsByCategory("art"));
---

<BaseLayout title="Art - FLIPSIGHT">
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">02 - Art</div>
        <h1 class="fs-display mt-4 max-w-3xl text-[clamp(38px,5vw,78px)] leading-[0.94]">
          THE RECORD ENDS.<br />THE IMAGE REMAINS.
        </h1>
      </div>
      <div class="grid gap-6">
        <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
          Limited editions, canvases, prints and objects made in and around FLIPSIGHT releases. Each work is numbered, signed, and documented.
        </p>
        <div class="flex justify-between border-t fs-soft-rule pt-3">
          <span class="fs-meta">{artProducts.length} works</span>
          <span class="fs-meta-muted">FLIPSART editions</span>
        </div>
      </div>
    </section>
    <ProductGrid products={artProducts} category="art" />
  </div>
</BaseLayout>
