---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { posts } from "../../data/posts";
---

<BaseLayout title="Blog - FLIPSIGHT">
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[6fr_5fr]">
      <div>
        <div class="fs-meta">05 - Blog</div>
        <h1 class="fs-display mt-4 text-[clamp(48px,6.5vw,104px)]">Notes from the label.</h1>
      </div>
      <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">
        Release notes, FLIPSART context, process fragments, and occasional news from the studio.
      </p>
    </section>

    <section>
      <SectionTitle eyebrow="Latest" note={`${posts.length} entries`} />
      <div class="grid gap-10 md:grid-cols-3">
        {posts.map((post) => <BlogCard {...post} />)}
      </div>
    </section>
  </div>
</BaseLayout>
