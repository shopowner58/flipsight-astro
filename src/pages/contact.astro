---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import NewsletterForm from "../components/NewsletterForm.astro";

const channels = [
  {
    label: "Email",
    value: "studio@flipsight.be",
    href: "mailto:studio@flipsight.be",
    note: "Orders, editions, releases and collaborations.",
  },
  {
    label: "Instagram",
    value: "@flipsight_",
    href: "https://www.instagram.com/flipsight_/",
    note: "Daily fragments, events and release context.",
  },
  {
    label: "Bandcamp",
    value: "flipsight.bandcamp.com",
    href: "https://flipsight.bandcamp.com/",
    note: "Digital previews, releases and artist pages.",
  },
  {
    label: "YouTube",
    value: "@Flipsight",
    href: "https://www.youtube.com/@Flipsight",
    note: "Clips, listening material and label moments.",
  },
  {
    label: "SoundCloud",
    value: "soundcloud.com/flipsight",
    href: "https://soundcloud.com/flipsight",
    note: "Audio fragments, mixes and label sounds.",
  },
  {
    label: "Domain",
    value: "flipsight.be",
    href: "https://flipsight.be",
    note: "The public catalogue, shop and archive.",
  },
];
---

<BaseLayout
  title="Contact - FLIPSIGHT"
  description="Contact FLIPSIGHT for releases, FLIPSART editions, events, orders and collaborations."
>
  <div class="fs-page flex flex-col gap-[clamp(64px,8vw,124px)]">
    <section class="grid items-end gap-10 lg:grid-cols-[7fr_5fr]">
      <div>
        <div class="fs-meta">Contact / Antwerp</div>
        <h1 class="fs-display mt-4 max-w-5xl text-[clamp(54px,8vw,128px)]">
          Reach<br />the label.
        </h1>
      </div>
      <div class="grid gap-6 lg:pb-3">
        <p class="max-w-xl text-[clamp(19px,2.2vw,30px)] leading-tight text-[var(--fs-ink)]">
          For releases, artworks, orders, events or collaborations, send a clear note. It lands with the studio, not in a ticket maze.
        </p>
        <div>
          <Button href="mailto:studio@flipsight.be" variant="secondary">Mail FLIPSIGHT</Button>
        </div>
      </div>
    </section>

    <section class="grid gap-8 border-y fs-rule py-[clamp(32px,5vw,72px)] lg:grid-cols-[4fr_8fr]">
      <div>
        <div class="fs-meta">Studio inbox</div>
        <h2 class="fs-display mt-3 text-[clamp(36px,4.8vw,74px)]">Write in.</h2>
      </div>
      <form class="fs-emailit-form grid gap-5" action="/api/contact" method="post" data-emailit-form>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="fs-meta-muted">Email</span>
            <input class="min-h-12 border-b border-[var(--fs-line)] bg-transparent font-mono text-[14px] outline-none placeholder:text-[var(--fs-mute)] focus:border-[var(--fs-accent)]" type="email" name="email" placeholder="email@domain.com" autocomplete="email" required />
          </label>
          <label class="grid gap-2">
            <span class="fs-meta-muted">Subject</span>
            <input class="min-h-12 border-b border-[var(--fs-line)] bg-transparent font-mono text-[14px] outline-none placeholder:text-[var(--fs-mute)] focus:border-[var(--fs-accent)]" type="text" name="subject" placeholder="Release, order, event..." required />
          </label>
        </div>
        <label class="grid gap-2">
          <span class="fs-meta-muted">Message</span>
          <textarea class="min-h-44 border border-[var(--fs-line-soft)] bg-transparent p-4 text-[15px] leading-relaxed outline-none placeholder:text-[var(--fs-mute)] focus:border-[var(--fs-accent)]" name="message" placeholder="Tell us what this is about." required></textarea>
        </label>
        <label class="flex items-start gap-3 text-[12px] leading-relaxed text-[var(--fs-mute)]">
          <input class="mt-1 h-3.5 w-3.5 accent-[var(--fs-ink)]" type="checkbox" name="consent" />
          <span>I want to receive FLIPSIGHT updates.</span>
        </label>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button class="min-h-12 border border-[var(--fs-line)] bg-[var(--fs-ink)] px-6 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--fs-bg)] transition-colors hover:bg-[var(--fs-accent)]" type="submit">
            Send message
          </button>
          <p class="min-h-5 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[var(--fs-mute)]" data-emailit-status aria-live="polite"></p>
        </div>
      </form>
    </section>

    <section class="grid gap-8 border-y fs-rule py-[clamp(32px,5vw,72px)] lg:grid-cols-[4fr_8fr]">
      <div>
        <div class="fs-meta">Channels</div>
        <h2 class="fs-display mt-3 text-[clamp(36px,4.8vw,74px)]">Direct lines.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          channels.map((channel) => (
            <a
              class="group grid gap-4 border-t fs-soft-rule pt-4 transition-colors hover:border-[var(--fs-ink)]"
              href={channel.href}
              target={channel.href.startsWith("http") ? "_blank" : undefined}
              rel={channel.href.startsWith("http") ? "noreferrer" : undefined}
            >
              <div class="flex items-baseline justify-between gap-4">
                <div class="fs-meta-muted">{channel.label}</div>
                <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--fs-mute)] transition-colors group-hover:text-[var(--fs-accent)]">
                  Open
                </span>
              </div>
              <div class="text-[clamp(18px,2vw,28px)] leading-tight text-[var(--fs-ink)] transition-colors group-hover:text-[var(--fs-accent)]">
                {channel.value}
              </div>
              <p class="max-w-sm text-[13px] leading-relaxed text-[var(--fs-mute)]">{channel.note}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="grid gap-8 lg:grid-cols-[4fr_8fr]">
      <div class="border-t fs-rule pt-5">
        <div class="fs-meta-muted">Base</div>
        <h2 class="fs-display mt-3 text-[clamp(32px,3.8vw,56px)]">Antwerp, Belgium.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <p class="text-[16px] leading-relaxed text-[var(--fs-ink-2)]">
          FLIPSIGHT works between records, visual editions and small rooms. If you are reaching out about a release, include listening links and a few lines of context.
        </p>
        <p class="text-[16px] leading-relaxed text-[var(--fs-ink-2)]">
          For order questions, include the order number and the email used at checkout. WooCommerce handles payment and shipping flow; we keep the communication human.
        </p>
      </div>
    </section>

    <section class="grid gap-8 border-t fs-soft-rule pt-[clamp(32px,5vw,72px)] lg:grid-cols-[4fr_8fr]">
      <div>
        <div class="fs-meta-muted">Newsletter</div>
        <h2 class="fs-display mt-3 text-[clamp(32px,3.8vw,56px)]">Release notes.</h2>
      </div>
      <div>
        <p class="mb-6 max-w-xl text-[16px] leading-relaxed text-[var(--fs-ink-2)]">
          Subscribe for records, editions, exhibition moments and rooms around the catalogue. No noise, no automation theatre.
        </p>
        <NewsletterForm />
      </div>
    </section>
  </div>
</BaseLayout>
