---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout
  title="Contact - FLIPSIGHT"
  description="Contact FLIPSIGHT for releases, FLIPSART editions, events, orders and collaborations."
>
  <div class="fs-page fs-page-stack">
    <section class="grid items-end gap-8 md:grid-cols-[5fr_6fr]">
      <div>
        <div class="fs-meta">Contact</div>
        <h1 class="fs-display mt-4 text-[clamp(50px,7vw,118px)]">Reach<br />the label.</h1>
      </div>
      <p class="max-w-xl text-[clamp(18px,2.1vw,28px)] leading-tight text-[var(--fs-ink)]">
        Questions about editions, orders, events, releases or collaborations can move through the studio inbox.
      </p>
    </section>

    <section>
      <SectionTitle eyebrow="Channels" note="Direct and minimal" />
      <div class="grid gap-6 border-t fs-rule pt-6 md:grid-cols-3">
        <a class="group border-t fs-soft-rule pt-4" href="mailto:studio@flipsight.be">
          <div class="fs-meta-muted">Email</div>
          <div class="mt-3 text-[18px] group-hover:text-[var(--fs-accent)]">studio@flipsight.be</div>
        </a>
        <a class="group border-t fs-soft-rule pt-4" href="https://www.instagram.com/flipsight">
          <div class="fs-meta-muted">Instagram</div>
          <div class="mt-3 text-[18px] group-hover:text-[var(--fs-accent)]">@flipsight</div>
        </a>
        <div class="border-t fs-soft-rule pt-4">
          <div class="fs-meta-muted">Base</div>
          <div class="mt-3 text-[18px]">Antwerp, Belgium</div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
