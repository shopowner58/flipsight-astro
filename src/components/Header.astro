---
import { getCartUrl, WOOCOMMERCE_URL } from "../lib/woocommerce";

const leftNav = [
  { href: "/music", label: "Music" },
  { href: "/art", label: "Art" },
  { href: "/events", label: "Events" },
];

const rightNav = [
  { href: "/merch", label: "Merch" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const mobileNav = [...leftNav, ...rightNav];
---

<header class="sticky top-0 z-40 border-b-[1.5px] fs-rule bg-[color-mix(in_oklab,var(--fs-bg)_92%,transparent)] backdrop-blur-md">
  <div class="grid grid-cols-[1fr_auto] items-center gap-5 px-6 py-4 md:grid-cols-[1fr_auto_1fr] md:px-[clamp(24px,3.2vw,56px)] md:py-5">
    <nav class="hidden items-center gap-7 md:flex">
      {leftNav.map((item) => (
        <a class="font-mono text-[11px] uppercase tracking-[0.14em] hover:text-[var(--fs-accent)]" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <a class="flex items-center justify-center text-center" href="/" aria-label="FLIPSIGHT home">
      <img
        class="h-auto w-[clamp(168px,16vw,252px)]"
        src="/brand/flipsight-logo-black.png"
        alt="FLIPSIGHT"
        width="1097"
        height="155"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden items-center justify-end gap-7 md:flex">
      {rightNav.map((item) => (
        <a class="font-mono text-[11px] uppercase tracking-[0.14em] hover:text-[var(--fs-accent)]" href={item.href}>
          {item.label}
        </a>
      ))}
      <a
        class="relative inline-flex h-9 w-9 items-center justify-center border border-[var(--fs-ink)] transition-colors hover:bg-[var(--fs-ink)] hover:text-[var(--fs-bg)]"
        href={getCartUrl()}
        aria-label="Cart"
        title="Cart"
      >
        <svg aria-hidden="true" class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M6.5 8.5h13l-1.4 8H8.1l-2-11H3.5" />
          <path d="M9 20h.01" />
          <path d="M17 20h.01" />
          <path d="M9 8.5a3 3 0 0 1 6 0" />
        </svg>
        <span data-cart-count class="absolute -right-2 -top-2 hidden min-w-[18px] border border-[var(--fs-ink)] bg-[var(--fs-ink)] px-1 py-[1px] text-center font-mono text-[9px] leading-[14px] text-[var(--fs-bg)]">0</span>
      </a>
    </nav>

    <details class="justify-self-end md:hidden">
      <summary class="cursor-pointer list-none font-mono text-[11px] uppercase tracking-[0.14em]">Menu</summary>
      <nav class="absolute left-0 right-0 top-full grid gap-4 border-b fs-soft-rule bg-[var(--fs-bg)] px-6 py-6">
        {mobileNav.map((item) => (
          <a class="font-mono text-[11px] uppercase tracking-[0.14em]" href={item.href}>{item.label}</a>
        ))}
        <a class="font-mono text-[11px] uppercase tracking-[0.14em]" href={getCartUrl()}>
          Cart <span data-cart-count class="hidden">0</span>
        </a>
      </nav>
    </details>
  </div>
  <script define:vars={{ cartEndpoint: `${WOOCOMMERCE_URL}/wp-json/wc/store/v1/cart` }}>
    async function updateFlipsightCartCount() {
      const badges = document.querySelectorAll("[data-cart-count]");
      if (!badges.length) return;

      try {
        const response = await fetch(cartEndpoint, {
          credentials: "include",
          headers: { Accept: "application/json" },
        });
        if (!response.ok) return;

        const cart = await response.json();
        const count = Number(cart.items_count || 0);
        badges.forEach((badge) => {
          badge.textContent = String(count);
          badge.classList.toggle("hidden", count < 1);
        });
      } catch {
        badges.forEach((badge) => badge.classList.add("hidden"));
      }
    }

    updateFlipsightCartCount();
    window.addEventListener("focus", updateFlipsightCartCount);
  </script>
</header>
