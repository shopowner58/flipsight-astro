---
import NewsletterForm from "./NewsletterForm.astro";

const year = new Date().getFullYear();
---

<footer class="mt-[clamp(80px,10vw,150px)] border-t fs-rule bg-[var(--fs-bg-2)] px-6 pb-7 pt-16 md:px-[clamp(24px,3.2vw,56px)]">
  <div class="mx-auto grid max-w-[1640px] gap-10 pb-12 lg:grid-cols-[1.35fr_0.7fr_0.9fr_1.3fr]">
    <div>
      <a class="mb-5 block w-fit" href="/" aria-label="FLIPSIGHT home">
        <img
          class="h-auto w-[clamp(170px,14vw,230px)]"
          src="/brand/flipsight-logo-black.png"
          alt="FLIPSIGHT"
          width="1097"
          height="155"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="max-w-sm text-[13.5px] leading-relaxed text-[var(--fs-ink-2)]">
        A curated world where music and image meet. Vinyl releases, collectible editions, merch and events in context.
      </p>
    </div>
    <div>
      <div class="fs-meta mb-4">Index</div>
      <ul class="grid gap-2 text-[13.5px] text-[var(--fs-ink-2)]">
        <li><a href="/music">Music</a></li>
        <li><a href="/art">Art</a></li>
        <li><a href="/merch">Merch</a></li>
        <li><a href="/events">Events</a></li>
      </ul>
    </div>
    <div>
      <div class="fs-meta mb-4">Contact</div>
      <ul class="grid gap-2 text-[13.5px] text-[var(--fs-ink-2)]">
        <li><a href="mailto:studio@flipsight.be">Email - studio@flipsight.be</a></li>
        <li><a href="https://www.instagram.com/flipsight_/" target="_blank" rel="noreferrer">Instagram - @flipsight_</a></li>
        <li><a href="https://www.youtube.com/@Flipsight" target="_blank" rel="noreferrer">YouTube - @Flipsight</a></li>
        <li><a href="https://soundcloud.com/flipsight" target="_blank" rel="noreferrer">SoundCloud - flipsight</a></li>
        <li><a href="https://flipsight.bandcamp.com/" target="_blank" rel="noreferrer">Bandcamp - flipsight</a></li>
      </ul>
    </div>
    <div>
      <div class="fs-meta mb-4">Updates</div>
      <p class="mb-5 max-w-sm text-[13.5px] leading-relaxed text-[var(--fs-ink-2)]">
        Low-frequency notes on records, editions, rooms and release windows.
      </p>
      <NewsletterForm compact />
    </div>
  </div>
  <div class="mx-auto flex max-w-[1640px] flex-col justify-between gap-3 border-t fs-soft-rule pt-6 font-mono text-[10.5px] uppercase tracking-[0.14em] text-[var(--fs-mute)] md:flex-row">
    <span>© FLIPSIGHT {year} · Flipsight VZW · BE 1027 581 772</span>
    <span>All works remain the property of their authors.</span>
  </div>
</footer>
