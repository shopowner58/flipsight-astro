---
import type { Post } from "../data/posts";

const post = Astro.props as Post;
const date = new Date(`${post.date}T12:00:00`).toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<article class="grid gap-4 border-t fs-soft-rule pt-4">
  <a href={`/blog/${post.slug}`} class="fs-vinyl-art aspect-[4/3] overflow-hidden" style="--tone: oklch(0.84 0.018 28)">
    {post.image && <img class="h-full w-full object-cover" src={post.image} alt={post.title} />}
  </a>
  <div class="fs-meta-muted">{date}</div>
  <a href={`/blog/${post.slug}`} class="fs-card-hover">
    <h2 class="fs-display text-[clamp(26px,2.4vw,38px)]">{post.title}</h2>
  </a>
  <p class="max-w-prose text-[14px] leading-relaxed text-[var(--fs-ink-2)]">{post.excerpt}</p>
</article>
