---
import Button from "./Button.astro";
import type { Product } from "../data/products";
import { getArtPreviewDetails } from "../lib/art-display";
import { getAddToCartUrl, getCheckoutAddToCartUrl } from "../lib/woocommerce";
import { getStockBadgeTone, getStockLabel, hasStockBadge, isCheckoutDisabled } from "../lib/stock";

type Props = Pick<Product, "id" | "slug" | "title" | "category" | "price" | "image" | "stockStatus" | "editionInfo" | "artist" | "catalog" | "format" | "year" | "hue" | "chroma" | "aspect" | "type" | "variants">;

const product = Astro.props as Props;
const tone = `oklch(0.84 ${product.chroma ?? 0.02} ${product.hue ?? 30})`;
const aspectClass = product.aspect === "portrait" || product.category !== "music" ? "aspect-[4/5]" : "aspect-square";
const releasePath = `/product/${product.slug}`;
const buyHref =
  product.stockStatus === "Pre-order"
    ? releasePath
    : product.type === "variable"
    ? `/product/${product.slug}`
    : product.category === "art"
    ? getCheckoutAddToCartUrl(product.id)
    : getAddToCartUrl(product.id, `/${product.category}`);
const buyLabel =
  product.stockStatus === "Pre-order"
    ? "Listen"
    : product.type === "variable"
    ? "Choose size"
    : product.category === "art"
      ? "Buy now"
      : "Add to cart";
const stockLabel = getStockLabel(product.stockStatus);
const buyDisabled = isCheckoutDisabled(product.stockStatus) && product.stockStatus !== "Pre-order";
const buyButtonHref = buyDisabled ? undefined : buyHref;
const artPreview = product.category === "art" ? getArtPreviewDetails(product) : null;
---

<article class="group grid gap-4">
  <a href={`/product/${product.slug}`} class={`fs-vinyl-art relative block overflow-hidden ${aspectClass}`} style={`--tone: ${tone}`}>
    {product.image && <img class="absolute inset-0 h-full w-full object-cover" src={product.image} alt={product.title} />}
    {hasStockBadge(product.stockStatus) && (
      <span class={`absolute left-3 top-3 z-10 rounded-none px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] shadow-sm ${getStockBadgeTone(product.stockStatus)}`}>
        {stockLabel}
      </span>
    )}
    <div class="absolute inset-x-0 bottom-0 flex justify-between p-4 font-mono text-[10px] uppercase tracking-[0.1em] text-[rgba(17,17,16,0.68)] mix-blend-multiply">
      <span>{product.category} / {product.catalog}</span>
      <span>{product.image ? "" : "FLIPSIGHT"}</span>
    </div>
  </a>

  <div class="border-t fs-soft-rule pt-3">
    <div class="mb-2 flex justify-between gap-4">
      <span class="fs-meta-muted">{product.catalog}</span>
      <span class={`fs-meta-muted text-right ${product.stockStatus === "Sold out" ? "text-[var(--fs-ink)]" : ""}`}>{stockLabel}</span>
    </div>
    <a href={`/product/${product.slug}`} class="fs-card-hover block">
      <h3 class="fs-display text-[17px] leading-tight">
        {product.artist ? <>{product.artist} <span class="text-[var(--fs-mute)]">/</span> <em>{product.title}</em></> : product.title}
        {artPreview && product.year && <> <span class="whitespace-nowrap font-normal">({product.year})</span></>}
      </h3>
    </a>
    {artPreview ? (
      <div class="mt-3 grid gap-1 font-mono text-[11px] tracking-[0.06em] text-[var(--fs-mute)]">
        {artPreview.sizes && <span>{artPreview.sizes}</span>}
        <span>{artPreview.medium}</span>
      </div>
    ) : (
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px] tracking-[0.06em] text-[var(--fs-mute)]">
        <span>{product.format ?? product.category}</span>
        <span>{product.editionInfo}</span>
        <span>{product.price}</span>
      </div>
    )}
    <div class="mt-5 flex gap-3">
      <Button href={`/product/${product.slug}`} variant="secondary">View</Button>
      <Button href={buyButtonHref} variant="ghost" disabled={buyDisabled}>
        {buyLabel}
      </Button>
    </div>
  </div>
</article>
