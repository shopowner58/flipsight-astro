---
import Button from "./Button.astro";

interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  musicImage?: string;
  musicTitle?: string;
  musicKicker?: string;
  musicHeading?: string;
  musicCta?: string;
  artImage?: string;
  artTitle?: string;
  artKicker?: string;
  artHeading?: string;
  artCta?: string;
}

const {
  title = "Pressed to move<br />framed to last",
  subtitle = "FLIPSIGHT is an independent music and art label publishing vinyl, editions, objects, and events in small, deliberate runs.",
  ctaLabel = "View selected editions",
  ctaHref = "/music",
  musicImage,
  musicTitle = "Vinyl releases",
  musicKicker = "01 - Music",
  musicHeading = "Vinyl releases<br />and sound objects.",
  musicCta = "Enter the music room",
  artImage,
  artTitle = "Collectible works",
  artKicker = "02 - Art",
  artHeading = "Collectible works<br />and limited editions.",
  artCta = "Enter the gallery",
} = Astro.props;
---

<section class="-mx-[clamp(24px,3.2vw,56px)] -mt-[clamp(48px,7vw,112px)] flex min-h-[calc(100vh-72px)] flex-col border-b fs-soft-rule md:flex-row">
  <a class="group relative min-h-[48vh] flex-1 overflow-hidden border-b fs-soft-rule transition-[flex-grow] duration-700 ease-[cubic-bezier(.2,.7,.2,1)] hover:flex-[1.22] md:min-h-0 md:border-b-0 md:border-r" href="/music">
    {
      musicImage ? (
        <img
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
          src={musicImage}
          alt={musicTitle}
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="fs-vinyl-art absolute inset-0 transition-transform duration-700 group-hover:scale-[1.035]" style="--tone: oklch(0.84 0.02 18)" />
      )
    }
    <div class="absolute inset-0 bg-[rgba(17,17,16,0.12)] mix-blend-multiply"></div>
    <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[rgba(17,17,16,0.74)] via-[rgba(17,17,16,0.38)] to-transparent p-[clamp(28px,3.5vw,56px)] pt-32 text-[var(--fs-bg)]">
      <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-[rgba(250,250,247,0.72)]">{musicKicker}</div>
      <h2 class="fs-display mt-3 text-[clamp(32px,4vw,58px)]" set:html={musicHeading}></h2>
      <div class="mt-5 font-mono text-[11px] uppercase tracking-[0.14em] opacity-70 transition-opacity group-hover:opacity-100">{musicCta}</div>
    </div>
  </a>

  <a class="group relative min-h-[48vh] flex-1 overflow-hidden transition-[flex-grow] duration-700 ease-[cubic-bezier(.2,.7,.2,1)] hover:flex-[1.22] md:min-h-0" href="/art">
    {
      artImage ? (
        <img
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
          src={artImage}
          alt={artTitle}
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="fs-vinyl-art absolute inset-0 transition-transform duration-700 group-hover:scale-[1.035]" style="--tone: oklch(0.84 0.025 220)" />
      )
    }
    <div class="absolute inset-0 bg-[rgba(17,17,16,0.1)] mix-blend-multiply"></div>
    <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[rgba(17,17,16,0.74)] via-[rgba(17,17,16,0.38)] to-transparent p-[clamp(28px,3.5vw,56px)] pt-32 text-[var(--fs-bg)]">
      <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-[rgba(250,250,247,0.72)]">{artKicker}</div>
      <h2 class="fs-display mt-3 text-[clamp(32px,4vw,58px)]" set:html={artHeading}></h2>
      <div class="mt-5 font-mono text-[11px] uppercase tracking-[0.14em] opacity-70 transition-opacity group-hover:opacity-100">{artCta}</div>
    </div>
  </a>

</section>

<section class="grid items-start gap-7 border-b fs-soft-rule pb-[clamp(32px,4vw,56px)] pt-[clamp(30px,4vw,60px)] md:grid-cols-[2fr_5fr_4fr]">
  <div class="border-t fs-rule pt-3">
    <div class="fs-meta">FLIPSIGHT</div>
    <div class="fs-meta-muted mt-2">Music / Art / Objects</div>
  </div>
  <div>
    <h1 class="fs-display max-w-3xl text-[clamp(34px,4.6vw,68px)]" set:html={title}></h1>
  </div>
  <div class="grid gap-5 md:pt-1">
    <p class="max-w-md text-[15px] leading-relaxed text-[var(--fs-ink-2)]">{subtitle}</p>
    <div>
      <Button href={ctaHref} variant="ghost">{ctaLabel}</Button>
    </div>
  </div>
</section>
