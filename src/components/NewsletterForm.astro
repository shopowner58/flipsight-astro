---
type Props = {
  compact?: boolean;
};

const { compact = false } = Astro.props;
---

<form
  class={`fs-emailit-form grid gap-3 ${compact ? "max-w-sm" : "max-w-xl"}`}
  action="/api/subscribe"
  method="post"
  data-emailit-form
>
  <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
    <label class="sr-only" for={`newsletter-email-${compact ? "compact" : "default"}`}>Email address</label>
    <input
      id={`newsletter-email-${compact ? "compact" : "default"}`}
      class="min-h-12 border-b border-[var(--fs-line)] bg-transparent px-0 font-mono text-[13px] outline-none placeholder:text-[var(--fs-mute)] focus:border-[var(--fs-accent)]"
      type="email"
      name="email"
      placeholder="email@domain.com"
      autocomplete="email"
      required
    />
    <button
      class="min-h-12 border border-[var(--fs-line)] px-5 font-mono text-[11px] uppercase tracking-[0.14em] transition-colors hover:border-[var(--fs-accent)] hover:text-[var(--fs-accent)]"
      type="submit"
    >
      Subscribe
    </button>
  </div>
  <label class="flex items-start gap-3 text-[12px] leading-relaxed text-[var(--fs-mute)]">
    <input class="mt-1 h-3.5 w-3.5 accent-[var(--fs-ink)]" type="checkbox" name="consent" required />
    <span>I want to receive FLIPSIGHT updates.</span>
  </label>
  <p class="min-h-5 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[var(--fs-mute)]" data-emailit-status aria-live="polite"></p>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>("[data-emailit-form]");

  forms.forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const status = form.querySelector<HTMLElement>("[data-emailit-status]");
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const idleText = button?.textContent ?? "Send";

      if (status) status.textContent = "Sending...";
      if (button) {
        button.disabled = true;
        button.textContent = "Sending";
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data.message ?? "Something went wrong.");
        }

        form.reset();
        if (status) status.textContent = data.message ?? "Done.";
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : "Could not send.";
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = idleText;
        }
      }
    });
  });
</script>
